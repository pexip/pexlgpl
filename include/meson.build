# Header force-included into consumers of the bundle.  See pexlgpl-prelude.h
# for the rationale.  It is installed into its own subdirectory and is
# deliberately never added to the bundle's own compile arguments: the sources
# merged into pexlgpl.dll must keep seeing the static view of GLib.

install_headers('pexlgpl-prelude.h', subdir : 'pexlgpl')
