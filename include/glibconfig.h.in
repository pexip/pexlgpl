/* pexlgpl override of GLib's glibconfig.h
 *
 * This is a generated file.  Please modify 'include/glibconfig.h.in'
 *
 * GLib is built as a *static* library and then merged into the single
 * dynamic pexlgpl bundle.  Because GLib is built with
 * default_library=static, its generated glibconfig.h contains
 *
 *   #define GLIB_STATIC_COMPILATION 1
 *
 * (and the GOBJECT/GIO/GMODULE/GI equivalents).  Those macros make
 * glib-visibility.h declare every exported symbol as plain 'extern'
 * instead of '__declspec(dllimport)'.
 *
 * That is correct while building GLib itself, but it is wrong for
 * consumers of the bundle: they link against pexlgpl.dll, so they must
 * use the dllimport view.  For functions the mismatch goes unnoticed
 * because an MSVC import library also provides a callable thunk under
 * the undecorated name, but exported *data* (such as g_utf8_skip) only
 * ever gets an __imp_ prefixed symbol, which results in
 *
 *   error LNK2001: unresolved external symbol g_utf8_skip
 *
 * The macros are baked into the installed header rather than passed on
 * the command line, so they cannot be dropped from the pkg-config
 * flags.  Instead this shim is installed in a directory that comes
 * first on the include path, pulls in the real header and then undoes
 * the static-compilation macros.
 */

#ifndef __PEXLGPL_GLIBCONFIG_H__
#define __PEXLGPL_GLIBCONFIG_H__

#include "@GLIBCONFIG@"

#undef GLIB_STATIC_COMPILATION
#undef GOBJECT_STATIC_COMPILATION
#undef GIO_STATIC_COMPILATION
#undef GMODULE_STATIC_COMPILATION
#undef GI_STATIC_COMPILATION

#endif /* __PEXLGPL_GLIBCONFIG_H__ */
